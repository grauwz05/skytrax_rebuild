# Copy to .env and fill in from your Snowflake trial account.
# Account identifier: Snowsight -> bottom-left account menu -> "Copy account identifier"
# It looks like ABCDEFG-HI12345 (organization-account), NOT the full URL.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=SKYTRAX_TRANSFORMER
SNOWFLAKE_WAREHOUSE=SKYTRAX_COMPUTE_XSMALL
SNOWFLAKE_DATABASE=SKYTRAX_REVIEWS_DB
SNOWFLAKE_SCHEMA=DBT_DEV
